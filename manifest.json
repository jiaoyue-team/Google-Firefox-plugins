{
  "manifest_version": 3,
  "name": "Google 主題",
  "version": "1.6",
  "version_name": "1.6",
  "description": "自訂新分頁：天氣、書籤與 Liquid Glass 特效",
  "permissions": [
    "geolocation",
    "bookmarks",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}